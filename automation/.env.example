OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# 글 생성 속도/품질 조절
ARTICLE_MIN_CHARS=3000
MAX_REVISION_ROUNDS=1
MAX_EXPANSION_ROUNDS=1

# gpt or naver
KEYWORD_SOURCE=gpt
BLOG_NICHE=IT 트렌드
BLOG_AUDIENCE=한국어 일반 독자
SEED_KEYWORDS=AI, 생산성, 자동화, 워드프레스
KEYWORD_COUNT=5

# Optional: Naver DataLab trend lookup.
# DataLab compares configured seed keywords, not global real-time search ranks.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_START_DATE=2026-04-07
NAVER_END_DATE=2026-05-07

# WordPress REST API
WORDPRESS_BASE_URL=https://example.com
WORDPRESS_USERNAME=
WORDPRESS_APP_PASSWORD=
WORDPRESS_STATUS=draft

# Publishing behavior
POSTS_PER_RUN=1
MIN_VERIFICATION_SCORE=80
DRY_RUN=true
